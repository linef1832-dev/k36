# ── Telegram (ขอที่ https://my.telegram.org → API development tools) ──
TG_API_ID=1234567
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ได้จากการรัน: npm run login   (ยาวมาก เก็บเป็นความลับ)
TG_SESSION=

# id กลุ่มเช็คอิน หาได้จาก: npm run chats   (ใส่หลายกลุ่มคั่นด้วย ,)
TG_CHATS=-1001234567890

# ── Supabase (Settings → API) ──
SUPABASE_URL=https://xxxxxxxx.supabase.co
# ⚠️ ต้องเป็น service_role key เท่านั้น ห้ามใช้ anon และห้ามเอาไปใส่ในหน้าเว็บ
SUPABASE_SERVICE_KEY=

# อ่านย้อนหลังกี่ข้อความตอนเปิดโปรแกรม (0 = ไม่ต้อง, 2000 = ประมาณ 1-2 วัน)
BACKFILL_MESSAGES=500
